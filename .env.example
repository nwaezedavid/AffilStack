APP_NAME=AffilStack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily = one file per day, kept for LOG_DAILY_DAYS — "single" grows forever.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production (Hostinger): mysql with the database hPanel creates for you.
# SQLite is only for local development.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production is served over HTTPS only — cookies must never travel over http.
SESSION_SECURE_COOKIE=true
# Leave null on a single domain. If AFFILIATE_SUBDOMAIN below is set to a
# real subdomain of this site (e.g. affiliate.affilstack.com) so affiliates
# get their own branded "Partner Portal" login/dashboard, set this to the
# shared parent domain with a leading dot (e.g. .affilstack.com) so the
# session cookie is valid on both the main domain and the subdomain —
# otherwise an affiliate's login on one won't carry over to the other.
SESSION_DOMAIN=null

# The affiliate program's own public landing/apply page, and the login
# affiliates use afterward, are served from this subdomain when set (see
# config/referrals.php and routes/web.php). Point its DNS at this same
# application. Leave unset to serve the affiliate pages from a plain
# /affiliate prefix on the main domain instead — useful for local dev,
# since it needs no real DNS.
# AFFILIATE_SUBDOMAIN=affiliate.affilstack.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest queued job (UGC video: 780s) or a second worker
# picks the same job up while it's still running.
DB_QUEUE_RETRY_AFTER=900

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AffilStack: AI provider ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# --- AffilStack: Flutterwave (payments) ---
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# --- AffilStack: Stripe (payments) ---
STRIPE_BASE_URL=https://api.stripe.com/v1
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AffilStack: Google Places (Phase 2, Google Maps lead-finding) ---
GOOGLE_PLACES_API_KEY=

# --- AffilStack: "Continue with Google" login/signup ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AffilStack: initial admin (used by AdminUserSeeder) ---
ADMIN_EMAIL=admin@affilstack.test
ADMIN_PASSWORD=change-this-password

# --- AffilStack: Chrome Web Store listing (set once the extension is published) ---
# CHROME_EXTENSION_STORE_URL=https://chromewebstore.google.com/detail/...
