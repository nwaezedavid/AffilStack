# Deny direct access to dotfiles (.htaccess, .env, .git, etc.) — HawkScan's
# pre-launch scan found /.htaccess itself readable over HTTP. Application-
# level redundancy for the same check lives in App\Http\Middleware\
# SecurityHeaders, for any front-end web server that isn't Apache.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Only index.php may ever run as PHP. Anything else that looks like code —
# a web shell dropped after an attack such as PHP2Shell, or a file someone
# managed to upload — is refused instead of executed.
<FilesMatch "\.(php[0-9]?|phtml|pht|phar|phps|pgif|shtml|cgi|pl|py|sh|inc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<Files "index.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# Release packages and backups are never downloadable, even for the
# moment one sits here during a deploy.
<FilesMatch "\.(zip|tar|tgz|gz|sql|bak|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Feature demo videos: some servers send WebM as plain text, which
# browsers refuse to play with nosniff on.
<IfModule mod_mime.c>
    AddType video/webm .webm
    AddType video/mp4 .mp4
</IfModule>

# Requests over 40 MB are refused by the web server before PHP reads them
# (AffilStack's biggest form is about 25 MB) — keeps oversized multipart
# bodies, PHP2Shell's memory-exhaustion path, away from PHP.
LimitRequestBody 41943040

# Static files (built CSS/JS, robots.txt, images) are served by Apache
# directly and never reach App\Http\Middleware\SecurityHeaders, so the one
# header HawkScan flagged as missing on them is set here instead.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"

    # Anything that could render as a page or run script if opened directly
    # (an old SVG logo, a stray HTML file under /storage) is sandboxed: no
    # script, no access to the site's cookies or origin.
    <FilesMatch "\.(svg|svgz|html?|xhtml|xml)$">
        Header set Content-Security-Policy "sandbox; default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Same rule for servers that skip <Files> sections: any address ending
    # in a code extension, other than /index.php itself, is refused.
    RewriteCond %{REQUEST_URI} !^/index\.php$ [NC]
    RewriteRule \.(php[0-9]?|phtml|pht|phar|phps|pgif|shtml|cgi|pl|py|sh|inc)$ - [F,L,NC]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
