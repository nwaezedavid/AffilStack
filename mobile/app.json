{
  "expo": {
    "name": "AffilStack",
    "slug": "affilstack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "affilstack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.affilstack.app",
      "supportsTablet": true,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock AffilStack with Face ID."
      },
      "associatedDomains": [
        "applinks:app.affilstack.com",
        "webcredentials:app.affilstack.com"
      ]
    },
    "android": {
      "package": "com.affilstack.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0b1e3d",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.affilstack.com",
              "path": "/dashboard"
            },
            {
              "scheme": "https",
              "host": "app.affilstack.com",
              "path": "/offers"
            },
            {
              "scheme": "https",
              "host": "app.affilstack.com",
              "pathPrefix": "/offers/"
            },
            {
              "scheme": "https",
              "host": "app.affilstack.com",
              "path": "/agents"
            },
            {
              "scheme": "https",
              "host": "app.affilstack.com",
              "path": "/crm"
            },
            {
              "scheme": "https",
              "host": "app.affilstack.com",
              "path": "/crm/inbox"
            },
            {
              "scheme": "https",
              "host": "app.affilstack.com",
              "pathPrefix": "/crm/inbox/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "AffilStack",
      "themeColor": "#0b1e3d",
      "backgroundColor": "#0b1e3d"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1e3d",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#0a1730",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock AffilStack with Face ID."
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-web-browser",
      "expo-video",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0b1e3d",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AffilStack uses your photos so you can pick a product picture for your videos.",
          "cameraPermission": "AffilStack uses the camera so you can take a product picture for your videos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "AffilStack needs access to your photos to save your videos.",
          "savePhotosPermission": "AffilStack saves your finished videos to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0b1e3d",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {}
    }
  }
}
